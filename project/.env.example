# Authentication - Required for admin panel
JWT_SECRET=your-secret-key-minimum-32-characters-long-change-this-in-production
ADMIN_PASSWORD_HASH=your-bcrypt-hashed-password-here

# Node Environment
NODE_ENV=development

# Supabase - Optional (only if using Supabase features)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# To generate ADMIN_PASSWORD_HASH:
# node -e "const bcrypt = require('bcryptjs'); console.log(bcrypt.hashSync('your-password', 10));" 