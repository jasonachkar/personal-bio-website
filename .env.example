# ==============================================================================
# ADMIN PANEL SECURITY CONFIGURATION
# ==============================================================================

# REQUIRED: Admin password (plain text - for development only)
# In production, use ADMIN_PASSWORD_HASH instead
ADMIN_PASSWORD=your_secure_password_here

# RECOMMENDED: Hashed admin password (for production)
# Generate using: node scripts/generate-password-hash.js YourPassword123!
# ADMIN_PASSWORD_HASH=your_bcrypt_hash_here

# REQUIRED: JWT secret for session tokens
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here

# ==============================================================================
# GITHUB INTEGRATION (Optional - for auto-committing content changes)
# ==============================================================================

# GitHub Personal Access Token with 'repo' scope
# Create at: https://github.com/settings/tokens
# GITHUB_TOKEN=your_github_personal_access_token

# Repository in format: username/repository-name
# GITHUB_REPO=username/repository-name

# Branch to commit to (default: main)
# GITHUB_BRANCH=main

# ==============================================================================
# AUTO-DEPLOY WEBHOOK (Optional - for automatic site rebuilds)
# ==============================================================================

# Webhook URL from your hosting provider
# Vercel: https://vercel.com/docs/rest-api/endpoints#create-a-deploy-hook
# Netlify: https://docs.netlify.com/configure-builds/build-hooks/
# REBUILD_WEBHOOK_URL=your_webhook_url_here

# ==============================================================================
# CONTACT FORM (Optional - Formspree integration)
# ==============================================================================

# Formspree endpoint for contact form
# Sign up at https://formspree.io and create a form
# NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/your_form_id

# ==============================================================================
# SECURITY SETTINGS (Advanced - Optional)
# ==============================================================================

# Maximum login attempts before temporary lockout (default: 5)
# MAX_LOGIN_ATTEMPTS=5

# Lockout duration in minutes (default: 30)
# LOCKOUT_DURATION=30

# Session duration in days (default: 7)
# SESSION_DURATION=7

# Enable strict IP validation for sessions (default: false)
# Recommended for production if users have static IPs
# STRICT_IP_VALIDATION=false

# Enable User-Agent validation for sessions (default: false)
# STRICT_UA_VALIDATION=false

# ==============================================================================
# LEGACY VARIABLES (Can be removed if not used)
# ==============================================================================

# Supabase (if previously configured)
# NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_key

# EmailJS (if previously configured)
# VITE_EMAILJS_PUBLIC_KEY=your_key
# VITE_EMAILJS_SERVICE_ID=your_service_id
# VITE_EMAILJS_TEMPLATE_ID=your_template_id

# ==============================================================================
# NOTES
# ==============================================================================
#
# SECURITY BEST PRACTICES:
# 
# 1. NEVER commit .env files to version control
# 2. Use different passwords for development and production
# 3. Rotate JWT_SECRET periodically (will invalidate all sessions)
# 4. Use ADMIN_PASSWORD_HASH in production instead of plain text password
# 5. Enable STRICT_IP_VALIDATION if users have static IP addresses
# 6. Monitor audit logs regularly for suspicious activity
# 7. Use strong passwords (12+ chars, mixed case, numbers, symbols)
# 8. Set up GitHub integration to backup content changes
# 9. Configure deploy webhooks for automatic updates
# 10. Keep dependencies up to date with `npm audit` and `npm update`
#
# DEPLOYMENT:
#
# - For Vercel: Set these variables in Settings → Environment Variables
# - For Netlify: Set these variables in Site settings → Environment variables
# - For other hosts: Use their respective environment variable configuration
#
